{
  "manifest_version": 3,
  "name": "Bypass TikTok Smart+",
  "version": "2.3.0",
  "description": "Restore Manual Campaign option for TikTok Ads Manager",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://ads.tiktok.com/*",
    "https://business.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ads.tiktok.com/*",
        "https://business.tiktok.com/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://ads.tiktok.com/*",
        "https://business.tiktok.com/*"
      ],
      "js": ["dat.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Bypass TikTok Smart+",
    "default_popup": "popup.html"
  }
}
